        MessageFormat: '''{0}'' usage'
        DefaultSeverity: 4
        IsEnabledByDefault: 1
        Areas: 512
        Platforms: 14000000
        Description: <b>System.Net</b> is not supported on this platform. This might
          lead to build/runtime errors.
        Recommendation: Do not use the System.Net API on this platform.
        DocumentationUrl: 
        MinimumVersion: 
        MaximumVersion: 
        Type: 
        Method: 
        Value: 
